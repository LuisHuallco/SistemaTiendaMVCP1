@model IEnumerable<SistemaTienda.Models.Compra>

@{
    ViewData["Title"] = "Compras";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h2>Lista de Compras</h2>
        <a asp-action="Create" class="btn btn-success">+ Nueva Compra</a>
    </div>

    <table class="table table-striped table-hover shadow">
        <thead class="table-dark">
            <tr>
                <th>Cliente</th>
                <th>Producto</th>
                <th>Fecha</th>
                <th>Cantidad</th>
                <th>Total</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Cliente.Nombre @item.Cliente.Apellido</td>
                    <td>@item.Producto.Nombre</td>
                    <td>@item.Fecha</td>
                    <td>@item.Cantidad</td>
                    <td>$@item.Total</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.CompraId" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.CompraId" class="btn btn-sm btn-info">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.CompraId" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>